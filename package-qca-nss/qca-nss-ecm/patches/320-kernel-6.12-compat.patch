 # Copyright (c) 2022-2023 Qualcomm Innovation Center, Inc. All rights reserved.
--- a/compat/asm/unaligned.h	1970-01-01 00:00:00.000000000 +0000
+++ b/compat/asm/unaligned.h	2026-08-02 22:16:05.471306012 +0000
@@ -0,0 +1,10 @@
+/* <asm/unaligned.h> was removed in kernel 6.12; contents moved to <linux/unaligned.h>. */
+#ifndef _ECM_COMPAT_ASM_UNALIGNED_H
+#define _ECM_COMPAT_ASM_UNALIGNED_H
+#include <linux/version.h>
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0))
+#include <linux/unaligned.h>
+#else
+#include_next <asm/unaligned.h>
+#endif
+#endif
--- a/ecm_interface.c	2026-08-02 22:10:22.726186006 +0000
