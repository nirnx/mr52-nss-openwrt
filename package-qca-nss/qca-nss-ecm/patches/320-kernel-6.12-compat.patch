Kernel 6.12 compat: asm/unaligned.h shim (moved to linux/unaligned.h in 6.10, removed in 6.12), const ctl_table handlers, ip_route_output gained a scope argument, sysctl sentinels guarded, explicit linux/vmalloc.h include.

--- a/Makefile	2026-08-02 22:10:22.726186006 +0000
+++ b/Makefile	2026-08-02 22:16:05.471306012 +0000
@@ -1,3 +1,4 @@
+ccflags-y += -I$(obj)/compat
 ##########################################################################
