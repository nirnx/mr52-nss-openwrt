strlcpy was removed in kernel 6.8; strscpy is a drop-in here.

--- a/ipq806x/nss_gmac_ethtool.c
+++ b/ipq806x/nss_gmac_ethtool.c
@@ -256,9 +256,9 @@
 static void nss_gmac_get_drvinfo(struct net_device *dev,
